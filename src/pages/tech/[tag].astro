---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/docs/Breadcrumb.astro';
import { loadContentGraph } from '../../lib/content-graph';

export async function getStaticPaths() {
  const graph = await loadContentGraph();
  const map = new Map<string, { label: string; slugs: string[] }>();
  for (const product of graph.products) {
    for (const tech of product.tech) {
      const tag = tech.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      if (!tag) continue;
      const current = map.get(tag) ?? { label: tech, slugs: [] };
      current.slugs.push(product.slug);
      map.set(tag, current);
    }
  }
  return [...map.entries()].map(([tag, value]) => ({
    params: { tag },
    props: { label: value.label, slugs: value.slugs },
  }));
}

const { label, slugs } = Astro.props;
const graph = await loadContentGraph();
const matched = graph.products.filter((product) => slugs.includes(product.slug));
---

<BaseLayout title={`用到 ${label} 的作品`} description={`本站用 ${label} 构建的作品列表。`}>
  <div class="wrap">
    <Breadcrumb items={[{ label: '技术栈' }, { label }]} />
    <h1>{label}</h1>
    <p class="lead">有 {matched.length} 个作品用到它。</p>
    <ul class="list">
      {
        matched.map((product) => (
          <li>
            <a href={`/products/${product.slug}/`}>{product.entry.data.name}</a>
            <span>{product.entry.data.tagline}</span>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) var(--gutter);
  }

  h1 {
    margin-top: var(--space-4);
    font-size: clamp(28px, 4vw, 40px);
  }

  .lead {
    margin-top: var(--space-2);
    color: var(--ink-muted);
  }

  .list {
    display: grid;
    gap: 0;
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  a {
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
  }

  a:hover {
    color: var(--accent-ink);
  }

  li span {
    color: var(--ink-muted);
    font-size: 14px;
    line-height: 1.7;
  }
</style>
