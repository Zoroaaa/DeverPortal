---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="请求的页面不存在。">
  <div class="container page">
    <p class="code" aria-hidden="true">404<span class="stop">.</span></p>
    <h1>页面不存在</h1>
    <p class="desc">这个地址没有对应的内容，可能是链接过期或拼写有误。</p>
    <p class="links">
      <a class="btn" href="/">返回首页</a>
      <a class="ghost" href="/products">浏览作品 →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(64px, 12vw, 160px);
  }

  .code {
    font-size: clamp(88px, 18vw, 200px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .stop {
    color: var(--accent);
  }

  h1 {
    margin-top: var(--space-6);
    font-size: clamp(24px, 3vw, 32px);
  }

  .desc {
    max-width: 40ch;
    margin-top: var(--space-3);
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
  }

  .btn {
    display: inline-flex;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ghost {
    color: var(--ink-muted);
    font-size: 15px;
    text-decoration: none;
  }

  .ghost:hover {
    color: var(--accent-ink);
  }
</style>
