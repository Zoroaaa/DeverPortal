---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { loadContentGraph, docPathOf } from '../../lib/content-graph';

const { products } = await loadContentGraph();
const withDocs = products.filter((product) => product.docs.length > 0);
---

<BaseLayout title="文档" noindex={withDocs.length === 0} description="按产品组织的使用手册与说明。">
  <div class="container page">
    <SectionHeader
      level={1}
      title="文档"
      description="使用手册按产品组织：说明、配置与已知限制都归在对应产品下，并随版本一起维护。"
    />
    {
      withDocs.length > 0 ? (
        <div class="doc-index">
          {withDocs.map((product) => (
            <section class="doc-group">
              <header class="group-head">
                <h2>{product.entry.data.name}</h2>
                <a href={`/products/${product.slug}`}>作品页 →</a>
              </header>
              <ul>
                {product.docs.map((doc) => (
                  <li>
                    <a href={`/docs/${product.slug}/${docPathOf(doc)}`}>
                      <span class="title">{doc.data.title}</span>
                      <span class="section">{doc.data.section}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <EmptyState
          title="文档整理中"
          description="目前还没有发布任何产品文档；有产品上线后会从这里进入各自的手册。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .doc-index {
    display: grid;
    gap: var(--space-12);
  }

  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .group-head h2 {
    font-size: 24px;
  }

  .group-head a {
    color: var(--ink-muted);
    font-size: 14px;
    text-decoration: none;
  }

  .group-head a:hover {
    color: var(--accent-ink);
  }

  ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 14px 0;
    text-decoration: none;
  }

  li a:hover .title {
    color: var(--accent-ink);
  }

  .title {
    font-size: 17px;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .section {
    color: var(--ink-faint);
    font-size: 14px;
    white-space: nowrap;
  }
</style>
