---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/docs/Breadcrumb.astro';
import ReleaseList from '../../../components/release/ReleaseList.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import { loadContentGraph, type ProductView } from '../../../lib/content-graph';

export async function getStaticPaths() {
  const { products } = await loadContentGraph();
  // 没有任何版本记录的作品不生成这一页，避免空页面进入索引。
  const withReleases = products.filter((product) => product.releaseViews.length > 0);
  return withReleases.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: ProductView;
}

const { product } = Astro.props;
---

<BaseLayout
  title={`${product.entry.data.name} 版本记录`}
  description={`${product.entry.data.name} 的全部版本记录与变更说明。`}
>
  <div class="container page">
    <Breadcrumb
      items={[
        { label: '首页', href: '/' },
        { label: '作品', href: '/products' },
        { label: product.entry.data.name, href: `/products/${product.slug}` },
        { label: '版本记录' },
      ]}
    />
    <div class="head">
      <SectionHeader
        level={1}
        title={`${product.entry.data.name} 版本记录`}
        description={`共 ${product.releaseViews.length} 条，按日期从新到旧；GitHub 自动条目只提供版本事实。`}
      />
    </div>
    {
      product.releaseViews.length > 0 ? (
        <ReleaseList releases={product.releaseViews} />
      ) : (
        <EmptyState
          title="暂无版本记录"
          description="仓库没有发布 Release 或打 tag；项目按 commit 维护，最近提交时间见作品页。"
        />
      )
    }
    <p class="back"><a href={`/products/${product.slug}`}>← 返回作品详情</a></p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-8);
  }

  .head {
    margin-top: var(--space-12);
  }


  .back {
    margin-top: var(--space-8);
    font-size: 15px;
  }

  .back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent-ink);
  }
</style>
