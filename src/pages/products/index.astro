---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { loadContentGraph } from '../../lib/content-graph';

const { products } = await loadContentGraph();
---

<BaseLayout title="作品" description="全部作品：状态、最近版本、已知限制。">
  <div class="container page">
    <SectionHeader
      level={1}
      title="作品"
      description="每个作品都写明状态、最近版本与已知限制。已归档的保留版本记录，便于回溯。"
    />
    {
      products.length > 0 ? (
        <div class="list">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="作品内容整理中"
          description="这里会按维护状态与主题筛选作品；目前还没有发布任何作品。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .list {
    border-top: 1px solid var(--line);
  }
</style>
