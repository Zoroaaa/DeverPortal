---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ReleaseList from '../components/release/ReleaseList.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { loadContentGraph } from '../lib/content-graph';

const { products, releaseViews } = await loadContentGraph();
const nameBySlug = new Map(products.map((product) => [product.slug, product.entry.data.name]));
---

<BaseLayout
  title="更新日志"
  noindex={releaseViews.length === 0}
  description="全部作品的版本记录，按时间从新到旧聚合。">
  <div class="container page">
    <SectionHeader
      level={1}
      title="更新日志"
      description="全站版本流水，按时间从新到旧。单个作品的历史在各自的作品页里。"
    />
    {
      releaseViews.length > 0 ? (
        <ReleaseList releases={releaseViews} names={nameBySlug} />
      ) : (
        <EmptyState
          title="更新记录整理中"
          description="作品发布版本后，这里会按时间从新到旧汇总全部记录。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

</style>
