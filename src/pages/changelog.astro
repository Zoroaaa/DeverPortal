---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ReleaseItem from '../components/release/ReleaseItem.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { loadContentGraph } from '../lib/content-graph';

const { products, releaseViews } = await loadContentGraph();
const nameBySlug = new Map(products.map((product) => [product.slug, product.entry.data.name]));
---

<BaseLayout title="更新日志" description="全部产品的版本记录，按时间从新到旧聚合。">
  <div class="container page">
    <SectionHeader
      level={1}
      fig="REV. 01"
      title="更新日志"
      aside={`${releaseViews.length} REV / ALL`}
      description="同一个版本集合的两个入口：这里看全站，产品页看单产品历史；GitHub 自动条目只提供版本事实。"
    />
    {
      releaseViews.length > 0 ? (
        <div class="rev-list">
          {releaseViews.map((release) => (
            <ReleaseItem release={release} productName={nameBySlug.get(release.productSlug)} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="更新记录整理中"
          description="产品发布版本后，这里会按时间从新到旧汇总全部记录。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(24px, 4vw, 48px);
  }

  .rev-list {
    border-top: 1px solid var(--ink);
  }
</style>
