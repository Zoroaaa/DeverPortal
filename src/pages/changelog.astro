---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ReleaseItem from '../components/release/ReleaseItem.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { loadContentGraph } from '../lib/content-graph';

const { products, releaseViews } = await loadContentGraph();
const nameBySlug = new Map(products.map((product) => [product.slug, product.entry.data.name]));
---

<BaseLayout title="更新日志" description="全部产品的版本记录，按时间从新到旧聚合。">
  <div class="container page">
    <SectionHeader
      level={1}
      title="更新日志"
      description="全站版本流水，按时间从新到旧。单个产品的历史在各自的产品页里。"
    />
    {
      releaseViews.length > 0 ? (
        <div class="list">
          {releaseViews.map((release) => (
            <ReleaseItem release={release} productName={nameBySlug.get(release.productSlug)} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="更新记录整理中"
          description="产品发布版本后，这里会按时间从新到旧汇总全部记录。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .list {
    border-top: 1px solid var(--line);
  }
</style>
