---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import Tag from '../../components/ui/Tag.astro';
import { loadContentGraph, postSlugOf, type PostEntry } from '../../lib/content-graph';
import { displayDate, formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const { posts } = await loadContentGraph();
  if (posts.every((post) => post.data.draft)) return [];
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: postSlugOf(post) },
      props: { post },
    }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.summary} type="article">
  <article class="container page">
    <header class="head">
      <h1>{post.data.title}</h1>
      <p class="meta meta-text">
        <time datetime={formatDate(post.data.date)}>{displayDate(post.data.date)}</time>
        {post.data.product && (
          <>
            <span aria-hidden="true">·</span>
            <a href={`/products/${post.data.product}`}>关联产品</a>
          </>
        )}
      </p>
      <p class="summary">{post.data.summary}</p>
      {
        post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => <Tag label={tag} />)}
          </div>
        )
      }
    </header>

    <div class="body">
      <Prose>
        <Content />
      </Prose>
    </div>

    <p class="back"><a href="/writing">← 全部文章</a></p>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: min(var(--w-content), 820px);
    padding-top: clamp(40px, 7vw, 88px);
  }

  .head {
    margin-bottom: var(--space-12);
  }

  h1 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .meta a {
    color: var(--ink-muted);
  }

  .summary {
    max-width: 58ch;
    margin-top: var(--space-4);
    color: var(--ink-muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .back {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: 15px;
  }

  .back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent-ink);
  }
</style>
