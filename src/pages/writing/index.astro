---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Tag from '../../components/ui/Tag.astro';
import { loadContentGraph, postSlugOf } from '../../lib/content-graph';
import { displayDate, formatDate } from '../../lib/format';

const { posts } = await loadContentGraph();
const visible = posts.filter((post) => !post.data.draft);
---

<BaseLayout title="写作" noindex={visible.length === 0} description="关于做法、取舍与踩坑的记录。">
  <div class="container page">
    <SectionHeader level={1} title="写作" description="叙述性长文，记录做法与取舍，不替代产品文档。" />
    {
      visible.length > 0 ? (
        <ul class="post-list">
          {visible.map((post) => (
            <li>
              <h2><a href={`/writing/${postSlugOf(post)}`}>{post.data.title}</a></h2>
              <p class="summary">{post.data.summary}</p>
              <div class="foot">
                <time class="meta-text" datetime={formatDate(post.data.date)}>
                  {displayDate(post.data.date)}
                </time>
                {post.data.tags.map((tag) => <Tag label={tag} />)}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="文章整理中"
          description="还在整理第一批写作内容；发布后会按时间列在这里。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .post-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .post-list li {
    display: grid;
    gap: 8px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.03em;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-ink);
  }

  .summary {
    max-width: 62ch;
    color: var(--ink-muted);
    font-size: 16px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: 4px;
  }
</style>
