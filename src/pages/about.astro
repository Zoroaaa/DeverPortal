---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { site } from '../data/site';
---

<BaseLayout title="关于" description={`${site.ownerName} 的背景、在做的事与联系方式。`}>
  <div class="container page">
    <SectionHeader level={1} title={site.ownerName} description={`${site.role} · ${site.location}`} />

    <div class="body">
      <p class="lead">{site.bio}</p>

      <h2>在做的事</h2>
      <p>
        维护一组自用的小工具，并把它们的定位、使用手册与版本记录公开出来。
        这里不放简历、不做技能进度条；判断一个作品的方式，是看它做到什么程度、有什么限制。
      </p>

      <h2 id="contact">联系</h2>
      <ul class="contact">
        <li>
          <span class="label">邮箱</span>
          <a href={site.emailHref}>{site.email}</a>
        </li>
        <li>
          <span class="label">GitHub</span>
          <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">
            {site.githubUsername}<span aria-hidden="true"> ↗</span>
            <span class="visually-hidden">（外部链接）</span>
          </a>
        </li>
        <li>
          <span class="label">RSS</span>
          <a href={site.rssHref}>订阅更新</a>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .body {
    max-width: 38em;
  }

  .lead {
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.02em;
  }

  h2 {
    margin-top: var(--space-16);
    font-size: 22px;
  }

  h2 + p {
    margin-top: var(--space-3);
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 1.85;
  }

  .contact {
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .contact li {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .label {
    flex: none;
    width: 72px;
    color: var(--ink-faint);
    font-size: 14px;
  }
</style>
