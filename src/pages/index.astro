---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ProductCard from '../components/product/ProductCard.astro';
import ReleaseItem from '../components/release/ReleaseItem.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { site } from '../data/site';
import { loadContentGraph } from '../lib/content-graph';
import { formatDate } from '../lib/format';

const { products, releaseViews, posts } = await loadContentGraph();
const nameBySlug = new Map(products.map((product) => [product.slug, product.entry.data.name]));

const featured = products.filter((product) => product.entry.data.featured);
const indexProducts = (featured.length > 0 ? featured : products).slice(0, 6);
const recentReleases = releaseViews.slice(0, 5);
const recentPosts = posts.filter((post) => !post.data.draft).slice(0, 3);

const drawings = String(products.length).padStart(2, '0');
const liveCount = String(products.filter((product) => product.entry.data.status === 'live').length).padStart(2, '0');
const lastRevision = releaseViews[0]?.date
  ? formatDate(releaseViews[0].date).replaceAll('-', '.')
  : '—';
---

<BaseLayout>
  <section class="container hero">
    <div class="hero-in">
      <div class="hero-main">
        <p class="eyebrow">DWG NO. DP-2026-01 · SCALE 1:1</p>
        <h1>作品，以及<br />它们的<u>说明书</u></h1>
        <p class="sub">{site.description}</p>
      </div>
      <dl class="titleblock">
        <div class="tr"><dt>项目</dt><dd>DEVERPORTAL</dd></div>
        <div class="tr"><dt>图纸数</dt><dd>{drawings}</dd></div>
        <div class="tr"><dt>在线</dt><dd>{liveCount}</dd></div>
        <div class="tr"><dt>制图</dt><dd>{site.ownerName.toUpperCase()}</dd></div>
        <div class="tr"><dt>最近修订</dt><dd>{lastRevision}</dd></div>
        <div class="tr note-row"><dt>说明</dt><dd>{products.length > 0 ? '全部自建 · 长期维护' : '内容整理中'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="container block">
    <SectionHeader
      fig="FIG. 01"
      title="图纸目录"
      aside={`${drawings} DWG / ${liveCount} LIVE`}
      description="每个作品都附状态、最近版本与已知限制。"
    />
    {
      indexProducts.length > 0 ? (
        <div class="product-grid">
          {indexProducts.map((product, index) => (
            <ProductCard product={product} fig={String(index + 1).padStart(2, '0')} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="作品内容整理中"
          description="作品的定位、状态与已知限制还在整理；整理完成后会在这里列出。"
        />
      )
    }
    <p class="more"><a href="/products">查看全部产品 →</a></p>
  </section>

  <section class="container block">
    <SectionHeader
      fig="FIG. 02"
      title="最近更新"
      aside={`${recentReleases.length} REV / RECENT`}
      description="跨产品的版本流水，点击版本号可查看该产品的全部记录。"
    />
    {
      recentReleases.length > 0 ? (
        <div class="rev-list">
          {recentReleases.map((release) => (
            <ReleaseItem
              release={release}
              productName={nameBySlug.get(release.productSlug)}
            />
          ))}
        </div>
      ) : (
        <EmptyState
          title="更新记录整理中"
          description="产品发布版本后，这里会按时间列出最近的更新与变更说明。"
        />
      )
    }
    <p class="more"><a href="/changelog">查看完整更新日志 →</a></p>
  </section>

  <section class="container block">
    <SectionHeader
      fig="FIG. 03"
      title="近期文章"
      aside={`${recentPosts.length} TEXT`}
      description="记录做法与取舍，不替代产品文档。"
    />
    {
      recentPosts.length > 0 ? (
        <ul class="post-list">
          {recentPosts.map((post) => (
            <li>
              <div class="post-meta">
                <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date).replaceAll('-', '.')}</time>
                <span>{post.data.type}</span>
              </div>
              <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.summary}</p>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="文章整理中"
          description="还在整理第一批写作内容；发布后会按时间列在这里。"
        />
      )
    }
    <p class="more"><a href="/writing">全部文章 →</a></p>
  </section>

  <section class="container block about-strip" id="contact">
    <SectionHeader fig="FIG. 04" title="关于" aside={site.role} />
    <p class="statement">{site.bio}</p>
    <p class="more"><a href="/about#contact">联系方式与背景 →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(24px, 4vw, 52px);
  }

  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 292px;
    align-items: stretch;
    gap: clamp(20px, 3vw, 40px);
    padding-block: clamp(22px, 3vw, 38px);
    border-block: 2px solid var(--ink);
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: '';
    flex: none;
    width: 26px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    max-width: 17ch;
    font-size: clamp(34px, 5.4vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  h1 u {
    text-decoration: none;
    box-shadow: inset 0 -0.16em 0 rgba(30, 76, 138, 0.16);
  }

  .sub {
    max-width: 44ch;
    margin-top: 20px;
    color: var(--ink-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .titleblock {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--ink);
  }

  .tr {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 11px;
    border-bottom: 1px dashed var(--line);
  }

  .tr:last-child {
    border-bottom: 0;
  }

  dt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  dd {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-align: right;
  }

  .note-row {
    margin-top: auto;
    background: var(--ink);
  }

  .note-row dt {
    color: #9fb0c6;
  }

  .note-row dd {
    color: var(--ink-inverse);
  }

  .block {
    padding-top: clamp(38px, 5vw, 68px);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
  }

  .rev-list {
    border-top: 1px solid var(--ink);
  }

  .more {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .more a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  .more a:hover {
    color: var(--accent);
  }

  .post-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .post-list li {
    display: grid;
    gap: 4px;
    padding: 12px 2px;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    gap: var(--space-3);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .post-list h3 {
    font-size: 16px;
    font-weight: 700;
  }

  .post-list h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-list h3 a:hover {
    color: var(--accent);
  }

  .post-list p {
    max-width: 68ch;
    color: var(--ink-muted);
    font-size: 13px;
  }

  .statement {
    max-width: 52ch;
    font-size: clamp(15px, 1.7vw, 19px);
    line-height: 1.75;
    letter-spacing: -0.01em;
  }

  @media (max-width: 767px) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    h1 {
      max-width: 14ch;
    }
  }
</style>
