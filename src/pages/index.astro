---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ProductCard from '../components/product/ProductCard.astro';
import ReleaseList from '../components/release/ReleaseList.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { site } from '../data/site';
import { loadContentGraph } from '../lib/content-graph';
import { displayDate, formatDate } from '../lib/format';

const { products, releaseViews, posts } = await loadContentGraph();
const nameBySlug = new Map(products.map((product) => [product.slug, product.entry.data.name]));

const featured = products.filter((product) => product.entry.data.featured);
const indexProducts = (featured.length > 0 ? featured : products).slice(0, 6);
const recentReleases = releaseViews.slice(0, 3);
const recentPosts = posts.filter((post) => !post.data.draft).slice(0, 3);

// 标语按首个逗号断成两行；句末的句号用强调色。
const [lead, ...restParts] = site.tagline.split('，');
const rest = restParts.join('，');
const restBody = rest.endsWith('。') ? rest.slice(0, -1) : rest;
const hasStop = rest.endsWith('。');
---

<BaseLayout>
  <section class="container hero">
    <h1>
      {lead}{rest ? '，' : ''}<br />{restBody}{hasStop && <span class="stop">。</span>}
    </h1>
    <p class="sub">{site.description}</p>
    <p class="cta">
      <a class="btn" href="/products">浏览作品<span aria-hidden="true"> →</span></a>
      <a class="ghost" href={site.githubUrl} target="_blank" rel="noopener noreferrer">
        GitHub<span aria-hidden="true"> ↗</span>
        <span class="visually-hidden">（外部链接）</span>
      </a>
    </p>
  </section>

  <section class="container block">
    <SectionHeader title="作品" href="/products" hrefLabel="全部作品" />
    {
      indexProducts.length > 0 ? (
        <div class="list">
          {indexProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="作品内容整理中"
          description="作品的定位、状态与已知限制还在整理；整理完成后会在这里列出。"
        />
      )
    }
  </section>

  {
    recentReleases.length > 0 && (
      <section class="container block">
        <SectionHeader title="最近更新" href="/changelog" hrefLabel="完整日志" />
        <ReleaseList releases={recentReleases} names={nameBySlug} />
      </section>
    )
  }

  {
    recentPosts.length > 0 && (
      <section class="container block">
        <SectionHeader title="文章" href="/writing" hrefLabel="全部文章" />
        <ul class="post-list">
          {recentPosts.map((post) => (
            <li>
              <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
              <p class="summary">{post.data.summary}</p>
              <time class="meta-text" datetime={formatDate(post.data.date)}>
                {displayDate(post.data.date)}
              </time>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="container block about" id="contact">
    <p class="statement">{site.bio}</p>
    <p class="cta">
      <a class="ghost" href="/about#contact">联系与背景<span aria-hidden="true"> →</span></a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(56px, 11vw, 136px);
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  h1 {
    font-size: clamp(42px, 8.6vw, 96px);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .stop {
    color: var(--accent);
  }

  .sub {
    max-width: 38em;
    margin-top: clamp(20px, 3vw, 32px);
    color: var(--ink-muted);
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.75;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ghost {
    color: var(--ink-muted);
    font-size: 15px;
    text-decoration: none;
  }

  .ghost:hover {
    color: var(--accent-ink);
  }

  .block {
    padding-top: clamp(56px, 8vw, 104px);
  }

  .list {
    border-top: 1px solid var(--line);
  }

  .post-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .post-list li {
    display: grid;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .post-list h3 {
    font-size: 20px;
  }

  .post-list h3 a {
    text-decoration: none;
  }

  .post-list h3 a:hover {
    color: var(--accent-ink);
  }

  .summary {
    max-width: 62ch;
    color: var(--ink-muted);
    font-size: 15px;
  }

  .about {
    padding-bottom: 0;
  }

  .statement {
    max-width: 30em;
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.02em;
  }
</style>
