---
interface Props {
  label: string;
  href?: string;
}

const { label, href } = Astro.props;
---

{href ? <a class="tag" href={href}>{label}</a> : <span class="tag">{label}</span>}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink-muted);
    font-size: 13px;
    line-height: 1.7;
    text-decoration: none;
    white-space: nowrap;
  }

  a.tag:hover {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
</style>
