---
interface Props {
  label: string;
  href?: string;
}

const { label, href } = Astro.props;
---

{href ? <a class="tag" href={href}>{label}</a> : <span class="tag">{label}</span>}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.7;
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
  }

  a.tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
