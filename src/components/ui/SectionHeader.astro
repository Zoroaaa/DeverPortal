---
interface Props {
  title: string;
  description?: string;
  level?: 1 | 2;
  href?: string;
  hrefLabel?: string;
}

const { title, description, level = 2, href, hrefLabel = '查看全部' } = Astro.props;
---

<header class:list={['shead', { 'shead--page': level === 1 }]}>
  <div class="head">
    {level === 1 ? <h1>{title}</h1> : <h2>{title}</h2>}
    {description && <p class="desc">{description}</p>}
  </div>
  {href && <a class="more" href={href}>{hrefLabel}<span aria-hidden="true"> →</span></a>}
</header>

<style>
  .shead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .head {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  h2 {
    font-size: clamp(22px, 2.6vw, 28px);
  }

  h1 {
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: -0.035em;
  }

  .shead--page {
    margin-bottom: var(--space-12);
  }

  .desc {
    max-width: 56ch;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .more {
    flex: none;
    color: var(--ink-muted);
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--accent-ink);
  }
</style>
