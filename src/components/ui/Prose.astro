---
// 文档与文章正文：纯纸底（关闭网格干扰），代码块与表格按图纸规格处理。
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--w-prose);
    padding-block: var(--space-2);
    background: var(--bg);
    font-size: 16px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .prose :global(> * + *) {
    margin-top: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    padding-top: 12px;
    border-top: 1px solid var(--ink);
    font-size: clamp(22px, 2.4vw, 28px);
  }

  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: 18px;
  }

  .prose :global(h4) {
    margin-top: var(--space-6);
    font-size: 15px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 6px;
    padding-left: 1.25em;
  }

  .prose :global(li)::marker {
    color: var(--accent);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    border-block: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 14.5px;
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .prose :global(pre),
  .prose :global(pre.astro-code) {
    padding: var(--space-4);
    overflow-x: auto;
    border: 1px solid var(--ink);
    border-top: 2px solid var(--accent);
    background: var(--surface) !important;
    font-size: 12.5px;
    line-height: 1.75;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    font-size: inherit;
    overflow-wrap: normal;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--ink);
    border-collapse: collapse;
    background: var(--surface);
    font-size: 13px;
  }

  .prose :global(thead) {
    background: rgba(30, 76, 138, 0.05);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    border-bottom: 1px solid var(--ink);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(hr) {
    margin-block: var(--space-8);
    border-top: 1px solid var(--ink);
  }

  .prose :global(img) {
    display: block;
    border: 1px solid var(--ink);
    background: var(--surface);
  }

  .prose :global(figcaption) {
    margin-top: 6px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }
</style>
