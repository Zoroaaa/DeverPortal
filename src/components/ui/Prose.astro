---
// 文档与文章正文：大行距、克制的强调，代码块与表格用柔和底色。
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--w-prose);
    font-size: 17px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .prose :global(> * + *) {
    margin-top: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    font-size: clamp(24px, 2.6vw, 30px);
  }

  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: 20px;
  }

  .prose :global(h4) {
    margin-top: var(--space-6);
    font-size: 17px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 6px;
    padding-left: 1.3em;
  }

  .prose :global(li)::marker {
    color: var(--accent);
  }

  .prose :global(a) {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
  }

  .prose :global(a:hover) {
    color: var(--accent-ink);
  }

  .prose :global(strong) {
    font-weight: 700;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    border-left: 3px solid var(--accent);
    color: var(--ink-muted);
  }

  .prose :global(details.evidence) {
    margin-top: var(--space-3);
  }

  .prose :global(details.evidence summary) {
    display: inline-block;
    color: var(--ink-faint);
    font-size: 13px;
    cursor: pointer;
  }

  .prose :global(details.evidence summary:hover) {
    color: var(--accent-ink);
  }

  .prose :global(details.evidence .evidence-body) {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--line-strong);
    color: var(--ink-faint);
    font-size: 14px;
    line-height: 1.75;
  }

  .prose :global(code) {
    padding: 0.12em 0.4em;
    border-radius: 6px;
    background: var(--bg-soft);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .prose :global(pre),
  .prose :global(pre.astro-code) {
    padding: var(--space-4) var(--space-6);
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--bg-soft) !important;
    font-size: 14px;
    line-height: 1.75;
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: inherit;
    overflow-wrap: normal;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-faint);
    font-size: 13px;
    font-weight: 600;
  }

  .prose :global(hr) {
    margin-block: var(--space-8);
  }

  .prose :global(img) {
    display: block;
    border-radius: var(--radius);
  }

  .prose :global(figcaption) {
    margin-top: 8px;
    color: var(--ink-faint);
    font-size: 13px;
  }
</style>
