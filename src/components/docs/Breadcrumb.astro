---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="面包屑">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
          {index < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .breadcrumb li {
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: var(--ink-faint);
  }

  a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .sep {
    color: var(--ink-faint);
  }

  [aria-current='page'] {
    color: var(--ink);
  }
</style>
