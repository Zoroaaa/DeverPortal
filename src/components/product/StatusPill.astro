---
import type { CollectionEntry } from 'astro:content';

interface Props {
  status: CollectionEntry<'products'>['data']['status'];
}

const { status } = Astro.props;

const labels = {
  live: '在线',
  beta: '测试',
  lab: '实验',
  archived: '已归档',
} as const;
---

<span class={`pill pill--${status}`}>
  <span class="dot" aria-hidden="true"></span>{labels[status]}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-muted);
    font-size: 13px;
    line-height: 1.5;
    white-space: nowrap;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .pill--live .dot {
    background: var(--status-live);
  }

  .pill--beta .dot {
    background: var(--status-beta);
  }

  .pill--lab .dot {
    background: var(--status-lab);
  }

  .pill--archived .dot {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--status-archived);
  }
</style>
