---
import StatusPill from './StatusPill.astro';
import type { ProductEntry, ReleaseView, GithubSnapshot } from '../../lib/content-graph';
import { formatDate } from '../../lib/format';

interface Props {
  status: ProductEntry['data']['status'];
  platforms: ProductEntry['data']['platforms'];
  latestRelease?: ReleaseView;
  snapshot: GithubSnapshot | null;
}

const { status, platforms, latestRelease, snapshot } = Astro.props;
const repo = snapshot?.data ?? null;
const stale = snapshot?.stale || snapshot?.missing || snapshot?.releasesStale;

const platformLabels: Record<string, string> = {
  web: 'Web',
  desktop: 'Desktop',
  cli: 'CLI',
  'self-host': 'Self-host',
  cloudflare: 'Cloudflare',
};

const platformText = platforms.map((platform) => platformLabels[platform] ?? platform).join(' / ');
const updated = latestRelease?.date ?? (repo?.pushedAt ? new Date(repo.pushedAt) : null);
const snapshotDate = snapshot?.fetchedAt ? snapshot.fetchedAt.slice(0, 10) : null;
---

<dl class="meta">
  <div class="row">
    <dt>状态</dt>
    <dd><StatusPill status={status} /></dd>
  </div>
  <div class="row">
    <dt>版本</dt>
    <dd>{latestRelease ? `v${latestRelease.version}` : '暂无发布'}</dd>
  </div>
  <div class="row">
    <dt>平台</dt>
    <dd>{platformText || '—'}</dd>
  </div>
  <div class="row">
    <dt>语言</dt>
    <dd>{repo?.language ?? '—'}</dd>
  </div>
  <div class="row">
    <dt>Stars</dt>
    <dd>{repo?.stars ?? '—'}</dd>
  </div>
  <div class="row">
    <dt>许可证</dt>
    <dd>{repo?.license ?? '未声明'}</dd>
  </div>
  <div class="row">
    <dt>更新</dt>
    <dd>{updated ? <time datetime={formatDate(updated)}>{formatDate(updated)}</time> : '—'}</dd>
  </div>
  <div class="row row--note">
    <dt>数据</dt>
    <dd>
      {snapshotDate ? `快照 ${snapshotDate}` : '无快照'}
      {stale && <span class="stale"> · 未同步</span>}
    </dd>
  </div>
</dl>

<style>
  .meta {
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }

  .row:last-child {
    border-bottom: 0;
  }

  dt {
    color: var(--ink-faint);
  }

  dd {
    min-width: 0;
    color: var(--ink);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .stale {
    color: var(--danger);
  }
</style>
