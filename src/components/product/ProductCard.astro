---
import StatusPill from './StatusPill.astro';
import type { ProductView } from '../../lib/content-graph';
import { formatDate } from '../../lib/format';

interface Props {
  product: ProductView;
}

const { product } = Astro.props;
const { entry, latestRelease, snapshot } = product;
const repo = snapshot?.data ?? null;

const platformLabels: Record<string, string> = {
  web: 'Web',
  desktop: 'Desktop',
  cli: 'CLI',
  'self-host': 'Self-host',
  cloudflare: 'Cloudflare',
};

const platforms = entry.data.platforms.map((platform) => platformLabels[platform] ?? platform).join(' / ');
const updatedSource = latestRelease?.date ?? (repo?.pushedAt ? new Date(repo.pushedAt) : null);
const updated = updatedSource ? formatDate(updatedSource).replaceAll('-', '.') : null;
const stale = snapshot?.stale || snapshot?.missing || snapshot?.releasesStale;

const facts = [
  latestRelease ? `v${latestRelease.version}` : null,
  platforms || null,
  repo?.language ?? null,
  updated ? `${updated} 更新` : null,
].filter(Boolean);
---

<article class="item">
  <a class="link" href={`/products/${product.slug}`}>
    <div class="main">
      <h3>{entry.data.name}</h3>
      <p class="tagline">{entry.data.tagline}</p>
      <p class="facts meta-text">
        {facts.join(' · ')}
        {stale && <span class="stale"> · 数据未同步</span>}
      </p>
    </div>
    <div class="side">
      <StatusPill status={entry.data.status} />
      <span class="arrow" aria-hidden="true">→</span>
    </div>
  </a>
</article>

<style>
  .item {
    border-bottom: 1px solid var(--line);
  }

  .link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: clamp(20px, 3vw, 28px) 0;
    color: inherit;
    text-decoration: none;
  }

  .link:hover {
    color: inherit;
  }

  .main {
    min-width: 0;
  }

  h3 {
    font-size: clamp(22px, 2.8vw, 30px);
    letter-spacing: -0.03em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .link:hover h3 {
    color: var(--accent-ink);
  }

  .tagline {
    margin-top: 6px;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .facts {
    margin-top: 10px;
  }

  .stale {
    color: var(--danger);
  }

  .side {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-6);
  }

  .arrow {
    color: var(--ink-faint);
    font-size: 22px;
    line-height: 1;
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .link:hover .arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  @media (max-width: 599px) {
    .link {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .side {
      gap: var(--space-4);
    }

    .arrow {
      display: none;
    }
  }
</style>
