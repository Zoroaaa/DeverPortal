---
import StatusPill from './StatusPill.astro';
import type { ProductView } from '../../lib/content-graph';
import { formatDate } from '../../lib/format';

interface Props {
  product: ProductView;
  fig: string;
}

const { product, fig } = Astro.props;
const { entry, latestRelease, snapshot } = product;
const repo = snapshot?.data ?? null;

const platformLabels: Record<string, string> = {
  web: 'Web',
  desktop: 'Desktop',
  cli: 'CLI',
  'self-host': 'Self-host',
  cloudflare: 'Cloudflare',
};

const platforms = entry.data.platforms.map((platform) => platformLabels[platform] ?? platform).join(' / ');
const updatedSource = latestRelease?.date ?? (repo?.pushedAt ? new Date(repo.pushedAt) : null);
const updated = updatedSource ? formatDate(updatedSource).replaceAll('-', '.') : '—';
const stale = snapshot?.stale || snapshot?.missing || snapshot?.releasesStale;
---

<article class="card">
  <div class="strip">
    <span class="fig">FIG. {fig} / {product.slug.toUpperCase()}</span>
    <StatusPill status={entry.data.status} />
  </div>
  <div class="body">
    <h3>{entry.data.name}</h3>
    <p class="tagline">{entry.data.tagline}</p>
    <dl class="spec">
      <div class="row">
        <dt>VER</dt>
        <dd>{latestRelease ? `v${latestRelease.version}` : 'NO RELEASES'}</dd>
      </div>
      <div class="row">
        <dt>PLATFORM</dt>
        <dd>{platforms || '—'}</dd>
      </div>
      <div class="row">
        <dt>LANG</dt>
        <dd>{repo?.language ?? '—'}</dd>
      </div>
      <div class="row">
        <dt>STARS</dt>
        <dd>{repo?.stars ?? '—'}</dd>
      </div>
      <div class="row">
        <dt>UPDATED</dt>
        <dd>
          {updatedSource ? <time datetime={formatDate(updatedSource)}>{updated}</time> : updated}
          {stale && <span class="stale"> STALE</span>}
        </dd>
      </div>
    </dl>
  </div>
  <a class="go" href={`/products/${product.slug}`} aria-label={`查看图纸：${entry.data.name}`}>
    <span aria-hidden="true">查看图纸 →</span>
  </a>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--ink);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .card::before,
  .card::after {
    content: '+';
    position: absolute;
    z-index: 1;
    background: var(--bg);
    padding: 0 2px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
  }

  .card::before {
    top: -7px;
    left: 14px;
  }

  .card::after {
    bottom: -7px;
    right: 14px;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .card:hover .go,
  .card:focus-within .go {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
  }

  .fig {
    min-width: 0;
    overflow: hidden;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .body {
    flex: 1;
    padding: 16px 14px 14px;
  }

  h3 {
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin-top: 6px;
    color: var(--ink-muted);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .spec {
    margin-top: 14px;
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 5px 0;
    border-bottom: 1px dotted var(--line);
  }

  dt {
    flex: none;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    min-width: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .stale {
    color: var(--danger);
    font-size: 9px;
  }

  .go {
    display: block;
    padding: 9px 14px;
    border-top: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
</style>
