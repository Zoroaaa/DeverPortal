---
import EmptyState from '../ui/EmptyState.astro';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 ? (
    <ul class="limits">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  ) : (
    <EmptyState title="暂无已知限制" description="该产品还没有补充限制说明。" />
  )
}

<style>
  .limits {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  li {
    position: relative;
    padding: 14px 0 14px 22px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  li::before {
    content: '';
    position: absolute;
    top: 1.35em;
    left: 2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
