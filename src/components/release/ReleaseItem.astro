---
import { marked } from 'marked';
import type { ReleaseView } from '../../lib/content-graph';
import { displayDate, formatDate } from '../../lib/format';
import Prose from '../ui/Prose.astro';

interface Props {
  release: ReleaseView;
  productName?: string;
  /** 聚合列表（首页 / 更新日志）默认不展开正文，避免把整页 Release 说明都塞进一个 HTML。 */
  showNotes?: boolean;
}

const { release, productName, showNotes = true } = Astro.props;
const { version, date, title, summary, highlights, breaking, channel, source, url, href, productSlug, body, stats } = release;

const dateText = date ? displayDate(date) : '日期未知';

// 标题只是版本号本身时没有信息量：聚合列表改显示产品名，单产品列表显示来源。
const rawCustomTitle = title.replace(/^v/i, '') === version ? null : title;
let customTitle = rawCustomTitle;
if (customTitle && productName) {
  const lower = customTitle.toLowerCase();
  if (lower.startsWith(productName.toLowerCase())) {
    const rest = customTitle.slice(productName.length).replace(/^[\s·:：\-–—]+/, '').trim();
    customTitle = rest && rest.replace(/^v/i, '') !== version ? rest : null;
  }
}
const sourceLabel = source === 'tag' ? 'Git tag' : 'GitHub Release';
const label = productName ? (customTitle ? `${productName} · ${customTitle}` : productName) : (customTitle ?? sourceLabel);
const target = source === 'manual' ? href : url;
const external = source !== 'manual' && Boolean(url);

// 自动条目里的 GitHub 统计：版本规模比正文更适合扫读，正文折叠到「发布说明」。
const statsText =
  stats && (stats.commits !== null || stats.filesChanged !== null || stats.additions !== null || stats.deletions !== null)
    ? [
        stats.commits !== null ? `${stats.commits} 次提交` : null,
        stats.filesChanged !== null ? `${stats.filesChanged} 个文件变更` : null,
        stats.additions !== null || stats.deletions !== null
          ? `+${stats.additions ?? 0} / −${stats.deletions ?? 0}`
          : null,
      ]
        .filter((item): item is string => Boolean(item))
        .join(' · ')
    : null;
// Release 正文是 GitHub 上的 Markdown，构建期转成 HTML；来源是自己仓库的公开内容，不做二次清洗。
const notesHtml = body ? (marked.parse(body, { async: false }) as string) : null;
---


<article class="release" id={`${productSlug}-${version}`}>
  <div class="row">
    <span class="ver">v{version}</span>
    <h3 class="title">
      {
        target ? (
          <a href={target} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {label}
            {external && <span aria-hidden="true"> ↗</span>}
            {external && <span class="visually-hidden">（GitHub 发布页）</span>}
          </a>
        ) : (
          label
        )
      }
    </h3>
    <p class="when meta-text">
      <time datetime={date ? formatDate(date) : undefined}>{dateText}</time>
    </p>
  </div>
  {statsText && <p class="stats meta-text">{statsText}</p>}
  {summary && <p class="summary">{summary}</p>}
  {
    highlights.length > 0 && (
      <ul class="highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  {
    (breaking || channel === 'beta') && (
      <p class="flags">
        {breaking && <span class="breaking">破坏性变更</span>}
        {channel === 'beta' && <span class="channel">Beta 通道</span>}
      </p>
    )
  }
  {
    showNotes && notesHtml && (
      <details class="notes">
        <summary>GitHub 发布说明</summary>
        <Prose>
          <div set:html={notesHtml} />
        </Prose>
      </details>
    )
  }
</article>

<style>
  .release {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
  }

  .ver {
    color: var(--accent-ink);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .title {
    min-width: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .when {
    text-align: right;
    white-space: nowrap;
  }

  .stats,
  .summary,
  .highlights,
  .flags,
  .notes {
    margin-left: calc(72px + var(--space-4));
  }

  .stats {
    margin-top: 6px;
  }

  .notes {
    margin-top: 10px;
  }

  .notes summary {
    color: var(--ink-faint);
    font-size: 13px;
    cursor: pointer;
  }

  .notes summary:hover {
    color: var(--accent-ink);
  }

  .notes :global(.prose) {
    margin-top: var(--space-3);
    font-size: 15px;
  }

  .notes :global(h2:first-child),
  .notes :global(h3:first-child) {
    margin-top: 0;
  }

  .summary {
    margin-top: 8px;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .highlights {
    display: grid;
    gap: 4px;
    margin-top: 8px;
    padding-left: 1.1em;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: 8px;
    font-size: 13px;
  }

  .breaking {
    color: var(--danger);
    font-weight: 600;
  }

  .channel {
    color: var(--status-beta);
  }


  @media (max-width: 700px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }

    .when {
      text-align: left;
    }

    .stats,
    .summary,
    .highlights,
    .flags,
    .notes {
      margin-left: 0;
    }
  }
</style>
