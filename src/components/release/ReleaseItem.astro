---
import type { ReleaseView } from '../../lib/content-graph';
import { displayDate, formatDate } from '../../lib/format';

interface Props {
  release: ReleaseView;
  productName?: string;
}

const { release, productName } = Astro.props;
const { version, date, title, summary, highlights, breaking, channel, source, url, href, productSlug } = release;

const dateText = date ? displayDate(date) : '日期未知';

// 标题只是版本号本身时没有信息量：聚合列表改显示产品名，单产品列表显示来源。
const customTitle = title.replace(/^v/i, '') === version ? null : title;
const sourceLabel = source === 'tag' ? 'Git tag' : 'GitHub Release';
const label = productName ? (customTitle ? `${productName} · ${customTitle}` : productName) : (customTitle ?? sourceLabel);
const target = source === 'manual' ? href : url;
const external = source !== 'manual' && Boolean(url);
---


<article class="release" id={`${productSlug}-${version}`}>
  <div class="row">
    <span class="ver">v{version}</span>
    <h3 class="title">
      {
        target ? (
          <a href={target} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {label}
            {external && <span aria-hidden="true"> ↗</span>}
            {external && <span class="visually-hidden">（GitHub 发布页）</span>}
          </a>
        ) : (
          label
        )
      }
    </h3>
    <p class="when meta-text">
      <time datetime={date ? formatDate(date) : undefined}>{dateText}</time>
    </p>
  </div>
  {summary && <p class="summary">{summary}</p>}
  {
    highlights.length > 0 && (
      <ul class="highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  {
    (breaking || channel === 'beta') && (
      <p class="flags">
        {breaking && <span class="breaking">破坏性变更</span>}
        {channel === 'beta' && <span class="channel">Beta 通道</span>}
      </p>
    )
  }
</article>

<style>
  .release {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
  }

  .ver {
    color: var(--accent-ink);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .title {
    min-width: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .when {
    text-align: right;
    white-space: nowrap;
  }

  .summary,
  .highlights,
  .flags {
    margin-left: calc(72px + var(--space-4));
  }

  .summary {
    margin-top: 8px;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .highlights {
    display: grid;
    gap: 4px;
    margin-top: 8px;
    padding-left: 1.1em;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: 8px;
    font-size: 13px;
  }

  .breaking {
    color: var(--danger);
    font-weight: 600;
  }

  .channel {
    color: var(--status-beta);
  }


  @media (max-width: 700px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }

    .when {
      text-align: left;
    }

    .summary,
    .highlights,
    .flags {
      margin-left: 0;
    }
  }
</style>
