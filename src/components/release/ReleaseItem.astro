---
import type { ReleaseView } from '../../lib/content-graph';
import { formatDate } from '../../lib/format';

interface Props {
  release: ReleaseView;
  productName?: string;
}

const { release, productName } = Astro.props;
const { version, date, title, summary, highlights, breaking, channel, source, url, href, productSlug } = release;

const sourceLabel: Record<ReleaseView['source'], string> = {
  manual: 'HANDWRITTEN',
  release: 'GITHUB RELEASE',
  tag: 'GIT TAG',
};
const dateText = date ? formatDate(date).replaceAll('-', '.') : '日期未知';
---

<article class="release" id={`${productSlug}-${version}`}>
  <div class="row">
    <span class="ver">v{version}</span>
    <time class="date" datetime={date ? formatDate(date) : undefined}>{dateText}</time>
    <h3 class="title">
      {
        source === 'manual' ? (
          <a href={href}>{title}</a>
        ) : url ? (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {title}
            <span aria-hidden="true"> ↗</span>
            <span class="visually-hidden">（GitHub 发布页）</span>
          </a>
        ) : (
          title
        )
      }
    </h3>
    <span class="product">{productName ?? productSlug}</span>
  </div>
  {summary && <p class="summary">{summary}</p>}
  {
    highlights.length > 0 && (
      <ul class="highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  <p class="flags">
    {breaking && <span class="breaking">BREAKING / 破坏性变更</span>}
    {channel === 'beta' && <span class="channel">BETA CHANNEL</span>}
    <span class="source">{sourceLabel[source]}</span>
    {source !== 'manual' && <span class="note">仅版本事实，改了什么以手写说明为准</span>}
  </p>
</article>

<style>
  .release {
    padding: 12px 2px;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .release:hover {
    background: rgba(30, 76, 138, 0.05);
  }

  .row {
    display: grid;
    grid-template-columns: 84px 96px minmax(0, 1fr) 130px;
    align-items: baseline;
    gap: var(--space-4);
  }

  .ver {
    color: var(--accent-warm-ink);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .date {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .title {
    min-width: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-align: right;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .summary {
    margin-top: 6px;
    padding-left: 212px;
    color: var(--ink-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .highlights {
    display: grid;
    gap: 2px;
    margin-top: 6px;
    padding-left: calc(212px + 1.1em);
    color: var(--ink-muted);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: 6px;
    padding-left: 212px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .breaking {
    color: var(--danger);
  }

  .channel {
    color: var(--accent-warm-ink);
  }

  .source {
    color: var(--ink-faint);
  }

  .note {
    color: var(--ink-faint);
    text-transform: none;
    letter-spacing: 0;
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 76px minmax(0, 1fr);
      row-gap: 4px;
    }

    .title {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .product {
      display: none;
    }

    .summary,
    .highlights,
    .flags {
      padding-left: 0;
    }
  }
</style>
