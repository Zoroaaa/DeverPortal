---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  canonical = Astro.url.pathname,
  ogImage = '/og.png',
  type = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.ownerName}` : `${site.ownerName} · ${site.title}`;
const siteUrl = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(canonical, siteUrl);
const pathname = Astro.url.pathname;

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));

const year = new Date().getFullYear();

// 仅首页输出站点/个人结构化数据，帮助搜索引擎识别站点主体。
const jsonLd =
  pathname === '/'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          { '@type': 'WebSite', name: `${site.ownerName} · ${site.title}`, url: siteUrl.href, inLanguage: 'zh-CN' },
          {
            '@type': 'Person',
            name: site.ownerName,
            jobTitle: site.role,
            url: siteUrl.href,
            sameAs: [site.githubUrl],
          },
        ],
      })
    : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/rss+xml" title={`${site.ownerName} · 订阅`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.ownerName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content="zh_CN" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${site.ownerName} · 首页`}>
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">{site.ownerName}</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot-inner">
        <p>© {year} {site.ownerName}</p>
        <ul>
          <li><a href="/changelog">更新日志</a></li>
          <li>
            <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">
              GitHub<span aria-hidden="true"> ↗</span>
              <span class="visually-hidden">（外部链接）</span>
            </a>
          </li>
          <li><a href={site.rssHref}>RSS</a></li>
          <li><a href={site.emailHref}>邮件</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .brand:hover .brand-dot {
    transform: scale(1.35);
  }

  .site-nav ul {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    position: relative;
    display: block;
    padding-block: 6px;
    color: var(--ink-muted);
    font-size: 15px;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .site-footer {
    margin-top: clamp(64px, 9vw, 120px);
    border-top: 1px solid var(--line);
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-8);
    color: var(--ink-faint);
    font-size: 14px;
  }

  .foot-inner ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot-inner a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .foot-inner a:hover {
    color: var(--accent-ink);
  }
</style>
