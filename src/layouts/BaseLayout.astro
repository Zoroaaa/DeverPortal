---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
}

const {
  title,
  description = site.description,
  canonical = Astro.url.pathname,
  ogImage,
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.ownerName}` : `${site.ownerName} · ${site.title}`;
const siteUrl = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(canonical, siteUrl);
const pathname = Astro.url.pathname;

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));

const sheet = pathname === '/'
  ? '01'
  : pathname.startsWith('/products')
    ? '02'
    : pathname.startsWith('/docs')
      ? '03'
      : pathname.startsWith('/writing')
        ? '04'
        : pathname.startsWith('/changelog')
          ? '05'
          : pathname.startsWith('/about')
            ? '06'
            : '07';

const now = new Date();
const rev = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}`;
const year = now.getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/rss+xml" title={`${site.ownerName} · 订阅`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.ownerName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl).href} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-name">{site.ownerName}</span>
          <span class="brand-sub">作品图纸集</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="stamp">
          <span>SHEET {sheet} / 07</span>
          <span>REV {rev}</span>
        </p>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot-inner">
        <div class="foot-grid">
          <div class="cell">
            <dl>
              <dt>作品</dt>
              <dd>DEVERPORTAL<br />作品图纸集<br />SHEET 01—07</dd>
            </dl>
          </div>
          <div class="cell">
            <dl>
              <dt>索引</dt>
              <dd>
                <a href="/products">产品</a><br />
                <a href="/docs">文档</a><br />
                <a href="/writing">写作</a><br />
                <a href="/changelog">更新日志</a>
              </dd>
            </dl>
          </div>
          <div class="cell">
            <dl>
              <dt>渠道</dt>
              <dd>
                <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">
                  GitHub<span aria-hidden="true"> ↗</span>
                  <span class="visually-hidden">（外部链接）</span>
                </a><br />
                <a href={site.rssHref}>RSS<span aria-hidden="true"> ↗</span></a>
              </dd>
            </dl>
          </div>
          <div class="cell">
            <dl>
              <dt>联系</dt>
              <dd>
                <a href={site.emailHref}>{site.email}</a><br />
                <a href="/about">关于<span aria-hidden="true"> ↗</span></a>
              </dd>
            </dl>
          </div>
          <div class="cell">
            <dl>
              <dt>版权</dt>
              <dd>© {year} {site.ownerName.toUpperCase()}<br />BUILT WITH ASTRO</dd>
            </dl>
          </div>
        </div>
        <div class="foot-bar">
          <span>SHEET 01—07</span>
          <span>REV {rev}</span>
          <span>SCALE 1:1</span>
          <span class="bar-hide">STATIC / ASTRO</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--ink);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: stretch;
    column-gap: var(--space-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block: 14px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .brand-sub {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
  }

  .site-nav ul {
    display: flex;
    align-items: stretch;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav li {
    display: flex;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-left: 1px solid var(--line);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .site-nav a:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .site-nav a[aria-current='page'] {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .stamp {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding-left: 16px;
    border-left: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.5;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .site-footer {
    margin-top: clamp(44px, 6vw, 80px);
    border-top: 2px solid var(--ink);
    background: var(--bg);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr;
    border-inline: 1px solid var(--ink);
  }

  .cell {
    min-width: 0;
    min-height: 86px;
    padding: 14px 14px 18px;
    border-right: 1px solid var(--ink);
  }

  .cell:last-child {
    border-right: 0;
  }

  .cell dt {
    margin-bottom: 8px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cell dd {
    color: var(--ink-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .cell a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .cell a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .foot-bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 8px 14px;
    border: 1px solid var(--ink);
    border-top: 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  @media (max-width: 899px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cell {
      border-bottom: 1px solid var(--ink);
    }

    .cell:nth-child(2n) {
      border-right: 0;
    }

    .cell:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .cell:last-child {
      grid-column: 1 / -1;
      border-top: 1px solid var(--ink);
      border-right: 0;
    }

    .foot-bar {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      column-gap: 0;
    }

    .brand {
      padding-block: 10px;
    }

    .stamp {
      display: none;
    }

    .site-nav {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line);
    }

    .site-nav ul {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .site-nav a {
      justify-content: center;
      padding: 9px 4px;
      border-left: 1px solid var(--line);
      font-size: 9px;
      letter-spacing: 0.08em;
    }

    .site-nav li:first-child a {
      border-left: 0;
    }

    .site-footer {
      margin-top: var(--space-12);
    }

    .cell {
      min-height: 0;
      padding: 12px;
    }

    .bar-hide {
      display: none;
    }
  }
</style>
