---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/docs/Breadcrumb.astro';
import TOC from '../components/docs/TOC.astro';
import type { DocEntry, ProductView } from '../lib/content-graph';
import { docPathOf } from '../lib/content-graph';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  product: ProductView;
  docs: DocEntry[];
  current?: DocEntry;
  headings: Heading[];
  breadcrumb: { label: string; href?: string }[];
}

const { title, description, product, docs, current, headings, breadcrumb } = Astro.props;
---

<BaseLayout
  title={`${title} · ${product.entry.data.name}`}
  description={description ?? product.entry.data.summary}
>
  <div class="container docs-page">
    <Breadcrumb items={breadcrumb} />

    <div class="docs-grid">
      <aside class="docs-nav" aria-label={`${product.entry.data.name} 文档目录`}>
        <div class="nav-head">
          <p class="nav-label">手册</p>
          <a class="nav-product" href={`/products/${product.slug}`}>{product.entry.data.name}</a>
        </div>
        {
          docs.length > 0 ? (
            <ul>
              {docs.map((doc) => (
                <li>
                  <a
                    href={`/docs/${product.slug}/${docPathOf(doc)}`}
                    aria-current={current && current.id === doc.id ? 'page' : undefined}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="nav-empty">暂无文档</p>
          )
        }
      </aside>

      <article class="docs-main">
        <header class="docs-head">
          <p class="kicker">{product.entry.data.name}</p>
          <h1>{title}</h1>
          {description && <p class="docs-desc">{description}</p>}
        </header>
        <slot />
      </article>

      <aside class="docs-toc" aria-label="页内目录">
        <TOC headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    max-width: var(--w-docs);
    padding-top: var(--space-6);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .docs-nav {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .nav-head {
    padding-bottom: var(--space-3);
  }

  .nav-label {
    color: var(--ink-faint);
    font-size: 13px;
  }

  .nav-product {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  .nav-product:hover {
    color: var(--accent-ink);
  }

  .docs-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav a {
    color: var(--ink-muted);
    font-size: 15px;
    text-decoration: none;
  }

  .docs-nav a:hover {
    color: var(--accent-ink);
  }

  .docs-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .nav-empty {
    color: var(--ink-faint);
    font-size: 14px;
  }

  .docs-main {
    min-width: 0;
    padding-bottom: var(--space-8);
  }

  .docs-head {
    max-width: var(--w-prose);
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 8px;
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .docs-head h1 {
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -0.035em;
  }

  .docs-desc {
    max-width: 58ch;
    margin-top: 12px;
    color: var(--ink-muted);
    font-size: 17px;
  }

  .docs-toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .docs-grid {
      grid-template-columns: 200px minmax(0, 1fr) 200px;
      gap: clamp(32px, 4vw, 64px);
    }

    .docs-nav {
      position: sticky;
      top: 88px;
      align-self: start;
      padding: 0;
      background: transparent;
    }

    .docs-nav ul {
      display: grid;
      gap: 2px;
    }

    .docs-nav a {
      display: block;
      padding: 5px 0 5px 12px;
      border-left: 2px solid var(--line);
    }

    .docs-nav a:hover {
      border-left-color: var(--accent);
    }

    .docs-nav a[aria-current='page'] {
      border-left-color: var(--accent);
    }

    .docs-toc {
      display: block;
    }
  }
</style>
