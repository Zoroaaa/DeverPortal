---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/docs/Breadcrumb.astro';
import TOC from '../components/docs/TOC.astro';
import type { DocEntry, ProductView } from '../lib/content-graph';
import { docPathOf } from '../lib/content-graph';
import { displayDate, formatDate } from '../lib/format';
import { site } from '../data/site';
import { breadcrumbJsonLd, techArticleJsonLd } from '../lib/seo';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  product: ProductView;
  docs: DocEntry[];
  current?: DocEntry;
  headings: Heading[];
  breadcrumb: { label: string; href?: string }[];
}

const { title, description, product, docs, current, headings, breadcrumb } = Astro.props;

const index = current ? docs.findIndex((doc) => doc.id === current.id) : -1;
const prev = index > 0 ? docs[index - 1] : undefined;
const next = index >= 0 ? docs[index + 1] : undefined;
const docHref = (doc: DocEntry) => `/docs/${product.slug}/${docPathOf(doc)}`;

// 文档目录按 section 分组，组内保持 order 排序；没有文档时退回空状态。
const sectionMap = new Map<string, DocEntry[]>();
for (const doc of docs) {
  const section = doc.data.section || '指南';
  sectionMap.set(section, [...(sectionMap.get(section) ?? []), doc]);
}
const sections = [...sectionMap.entries()]
  .map(([section, items]) => ({
    section,
    items,
    order: Math.min(...items.map((doc) => doc.data.order)),
  }))
  .sort((a, b) => a.order - b.order);

const structuredData = current
  ? [
      techArticleJsonLd({
        title: current.data.title,
        description: current.data.description ?? product.entry.data.summary,
        url: new URL(`/docs/${product.slug}/${docPathOf(current)}`, site.url).href,
        updatedAt: current.data.updatedAt,
        productName: product.entry.data.name,
      }),
      breadcrumbJsonLd(breadcrumb),
    ]
  : undefined;
---

<BaseLayout
  title={`${title} · ${product.entry.data.name}`}
  description={description ?? product.entry.data.summary}
  structuredData={structuredData}
>
  <div class="container docs-page">
    <Breadcrumb items={breadcrumb} />

    <div class="docs-grid">
      <aside class="docs-nav" aria-label={`${product.entry.data.name} 文档目录`}>
        <div class="nav-head">
          <p class="nav-label">手册</p>
          <a class="nav-product" href={`/products/${product.slug}`}>{product.entry.data.name}</a>
        </div>
        {
          sections.length > 0 ? (
            sections.map((group) => (
              <div class="nav-section">
                <p class="nav-section-title">{group.section}</p>
                <ul>
                  {group.items.map((doc) => (
                    <li>
                      <a
                        href={`/docs/${product.slug}/${docPathOf(doc)}`}
                        aria-current={current && current.id === doc.id ? 'page' : undefined}
                      >
                        {doc.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          ) : (
            <p class="nav-empty">暂无文档</p>
          )
        }
      </aside>

      <article class="docs-main">
        <header class="docs-head">
          <p class="kicker">{product.entry.data.name}</p>
          <h1>{title}</h1>
          {description && <p class="docs-desc">{description}</p>}
          {
            current && (
              <p class="docs-meta meta-text">
                <time datetime={formatDate(current.data.updatedAt)}>更新于 {displayDate(current.data.updatedAt)}</time>
                {current.data.appliesTo && <span>适用版本 {current.data.appliesTo}</span>}
              </p>
            )
          }
        </header>
        <slot />
        {
          (prev || next) && (
            <nav class="docs-pager" aria-label="上一篇与下一篇">
              {prev ? (
                <a class="pager-link" href={docHref(prev)} rel="prev">
                  <span class="pager-label">上一篇</span>
                  <span class="pager-title">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="pager-link pager-link--next" href={docHref(next)} rel="next">
                  <span class="pager-label">下一篇</span>
                  <span class="pager-title">{next.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </article>

      <aside class="docs-toc" aria-label="页内目录">
        <TOC headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    max-width: var(--w-docs);
    padding-top: var(--space-6);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .docs-nav {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .nav-head {
    padding-bottom: var(--space-3);
  }

  .nav-label {
    color: var(--ink-faint);
    font-size: 13px;
  }

  .nav-product {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  .nav-product:hover {
    color: var(--accent-ink);
  }

  .docs-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav a {
    color: var(--ink-muted);
    font-size: 15px;
    text-decoration: none;
  }

  .docs-nav a:hover {
    color: var(--accent-ink);
  }

  .docs-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .nav-section + .nav-section {
    margin-top: var(--space-3);
  }

  .nav-section-title {
    margin-bottom: 2px;
    color: var(--ink-faint);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .nav-empty {
    color: var(--ink-faint);
    font-size: 14px;
  }

  .docs-main {
    min-width: 0;
    padding-bottom: var(--space-8);
  }

  .docs-head {
    max-width: var(--w-prose);
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 8px;
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .docs-head h1 {
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -0.035em;
  }

  .docs-desc {
    max-width: 58ch;
    margin-top: 12px;
    color: var(--ink-muted);
    font-size: 17px;
  }

  .docs-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-4);
  }

  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    max-width: var(--w-prose);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .pager-link {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--bg-soft);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .pager-link:hover {
    background: var(--accent-soft);
    color: inherit;
  }

  .pager-link--next {
    grid-column: 2;
    text-align: right;
  }

  .pager-label {
    color: var(--ink-faint);
    font-size: 13px;
  }

  .pager-title {
    font-weight: 600;
  }

  .docs-toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .docs-grid {
      grid-template-columns: 200px minmax(0, 1fr) 200px;
      gap: clamp(32px, 4vw, 64px);
    }

    .docs-nav {
      position: sticky;
      top: 88px;
      align-self: start;
      padding: 0;
      background: transparent;
    }

    .docs-nav ul {
      display: grid;
      gap: 2px;
    }

    .docs-nav a {
      display: block;
      padding: 5px 0 5px 12px;
      border-left: 2px solid var(--line);
    }

    .docs-nav a:hover {
      border-left-color: var(--accent);
    }

    .docs-nav a[aria-current='page'] {
      border-left-color: var(--accent);
    }

    .docs-toc {
      display: block;
    }
  }
</style>
