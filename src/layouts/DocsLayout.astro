---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/docs/Breadcrumb.astro';
import TOC from '../components/docs/TOC.astro';
import type { DocEntry, ProductView } from '../lib/content-graph';
import { docPathOf } from '../lib/content-graph';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  product: ProductView;
  docs: DocEntry[];
  current?: DocEntry;
  headings: Heading[];
  breadcrumb: { label: string; href?: string }[];
}

const { title, description, product, docs, current, headings, breadcrumb } = Astro.props;
---

<BaseLayout
  title={`${title} · ${product.entry.data.name}`}
  description={description ?? product.entry.data.summary}
>
  <div class="container docs-page">
    <Breadcrumb items={breadcrumb} />

    <div class="docs-grid">
      <aside class="docs-nav" aria-label={`${product.entry.data.name} 文档目录`}>
        <div class="nav-head">
          <p class="nav-label">MANUAL</p>
          <a class="nav-product" href={`/products/${product.slug}`}>{product.entry.data.name}</a>
        </div>
        {
          docs.length > 0 ? (
            <ul>
              {docs.map((doc) => (
                <li>
                  <a
                    href={`/docs/${product.slug}/${docPathOf(doc)}`}
                    aria-current={current && current.id === doc.id ? 'page' : undefined}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="nav-empty">暂无文档</p>
          )
        }
      </aside>

      <article class="docs-main">
        <header class="docs-head">
          <p class="kicker">{product.entry.data.name} / DOC</p>
          <h1>{title}</h1>
          {description && <p class="docs-desc">{description}</p>}
        </header>
        <slot />
      </article>

      <aside class="docs-toc" aria-label="页内目录">
        <TOC headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    padding-top: var(--space-6);
  }

  .docs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .docs-nav {
    background: var(--surface);
    border: 1px solid var(--ink);
  }

  .nav-head {
    padding: 10px 12px;
    border-bottom: 1px solid var(--ink);
  }

  .nav-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav-product {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  .nav-product:hover {
    color: var(--accent);
  }

  .docs-nav ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 6px 10px;
    list-style: none;
  }

  .docs-nav li + li::before {
    content: '/';
    margin: 0 6px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .docs-nav a {
    color: var(--ink-muted);
    font-size: 12.5px;
    text-decoration: none;
  }

  .docs-nav a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .docs-nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nav-empty {
    padding: 8px 12px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .docs-main {
    min-width: 0;
    padding: clamp(14px, 2.4vw, 26px) 0 var(--space-8);
    background: var(--bg);
  }

  .docs-head {
    max-width: var(--w-prose);
    margin-inline: auto;
    padding-top: 14px;
    margin-bottom: var(--space-6);
    border-top: 2px solid var(--ink);
  }

  .kicker {
    margin-bottom: 8px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .docs-head h1 {
    font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: -0.03em;
  }

  .docs-desc {
    max-width: 62ch;
    margin-top: 8px;
    color: var(--ink-muted);
    font-size: 14px;
  }

  .docs-toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .docs-grid {
      grid-template-columns: 220px minmax(0, 1fr) 200px;
      gap: clamp(24px, 3vw, 44px);
    }

    .docs-nav {
      position: sticky;
      top: 84px;
      align-self: start;
    }

    .docs-nav ul {
      display: grid;
      padding: 6px 0;
    }

    .docs-nav li + li::before {
      content: none;
    }

    .docs-nav a {
      display: block;
      padding: 6px 12px;
      border-left: 2px solid transparent;
    }

    .docs-nav a:hover {
      background: rgba(30, 76, 138, 0.05);
      border-left-color: var(--line-strong);
      text-decoration: none;
    }

    .docs-nav a[aria-current='page'] {
      border-left-color: var(--accent);
      background: rgba(30, 76, 138, 0.05);
      text-decoration: none;
    }

    .docs-main {
      padding: 0 clamp(0px, 2vw, 24px) var(--space-12);
    }

    .docs-main > :global(.prose) {
      margin-inline: auto;
    }

    .docs-toc {
      display: block;
      padding-top: 20px;
    }
  }
</style>
